diff --git a/arch/arm64/boot/dts/qcom/msm8916-qmodem-rescue.dts b/arch/arm64/boot/dts/qcom/msm8916-qmodem-rescue.dts
new file mode 100644
index 000000000..6ac105803
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8916-qmodem-rescue.dts
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// UFI103S V03: validated UFI001C USB/eMMC/red LED wiring, with minimal TF-A.
+#include "msm8916-thwc-ufi001c.dts"
+
+/ {
+	model = "UFI103S V03 qmodem CPU bring-up";
+	compatible = "qmodem,ufi103s-v03", "thwc,ufi001c", "qcom,msm8916";
+	qcom,msm-id = <206 0>;
+	qcom,board-id = <8 0x100>;
+};
+
+/* Minimal TF-A supports CPU_ON, but not CPU_OFF/CPU_SUSPEND.
+ * Architectural WFI remains available; do not advertise power-collapse domains.
+ */
+&cpu0 {
+	/delete-property/ power-domains;
+	/delete-property/ power-domain-names;
+};
+&cpu1 {
+	/delete-property/ power-domains;
+	/delete-property/ power-domain-names;
+};
+&cpu2 {
+	/delete-property/ power-domains;
+	/delete-property/ power-domain-names;
+};
+&cpu3 {
+	/delete-property/ power-domains;
+	/delete-property/ power-domain-names;
+};
+
+/* These consumers are outside the validated USB/eMMC CPU profile. Disable their
+ * IOMMUs too, rather than probing unused secure-world dependencies or masking
+ * their clock errors. This does not fix the underlying IOMMU handoff issue.
+ */
+&gpu { status = "disabled"; };
+&gpu_iommu { status = "disabled"; };
+&apps_iommu { status = "disabled"; };
+&mpss { status = "disabled"; };
+/* Minimal TF-A delegates WCNSS reset/loading to the non-secure driver. */
+&wcnss {
+	status = "okay";
+	resets = <&gcc GCC_WCSS_RESTART>;
+	qcom,halt-regs = <&tcsr 0x1b000>;
+};
+&venus { status = "disabled"; };
+
+/* Red LED GPIO22 is physically verified. Other board GPIOs are unverified. */
+&led_r { default-state = "off"; };
+&button_restart { status = "disabled"; };
+&led_g { status = "disabled"; };
+&led_b { status = "disabled"; };
