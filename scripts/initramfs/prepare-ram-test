#!/bin/sh
# Run only through SSH in the explicit qmodem.test=1 RAM-boot image.
set -eu
case " $(cat /proc/cmdline) " in *' qmodem.test=1 '*) ;; *) echo 'Not a RAM test boot' >&2; exit 1;; esac
[ -f /tmp/debian-test.squashfs ]
! mountpoint -q /newroot
mount -t squashfs -o loop,ro /tmp/debian-test.squashfs /newroot
# Keep the full Debian /usr read-only. Only runtime state lives in small tmpfs.
# APT's large index cache is unnecessary for boot and remains excluded here.
tar -C /newroot --exclude=var/lib/apt/lists --exclude=var/cache/apt -cf /run/debian-writable.tar etc var
mount -t tmpfs -o size=8m,mode=755 tmpfs /newroot/etc
mount -t tmpfs -o size=32m,mode=755 tmpfs /newroot/var
tar -C /newroot -xf /run/debian-writable.tar
rm /run/debian-writable.tar
mount -t tmpfs -o size=8m,mode=1777 tmpfs /newroot/tmp
# This is a RAM-root boot, so do not request the production userdata remount.
printf '# RAM-only systemd test: no eMMC mounts\n' > /newroot/etc/fstab
/sbin/qmodem-check-root
printf 'Prepared RAM Debian root; handoff has not started.\n'
