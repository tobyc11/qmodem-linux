#!/bin/sh
set -eu
mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config
cd /sys/kernel/config/usb_gadget
# Rescue and Debian use the same gadget; reuse it during a RAM-test handoff.
[ ! -d rescue ] || exit 0
mkdir rescue
cd rescue
echo 0x1d6b > idVendor
echo 0x0104 > idProduct
mkdir -p strings/0x409 configs/c.1/strings/0x409
echo 430172fb > strings/0x409/serialnumber
echo qmodem > strings/0x409/manufacturer
echo 'UFI103S Debian' > strings/0x409/product
echo 'USB Ethernet' > configs/c.1/strings/0x409/configuration
mkdir functions/ecm.usb0
echo '02:00:00:10:03:01' > functions/ecm.usb0/dev_addr
echo '02:00:00:10:03:02' > functions/ecm.usb0/host_addr
ln -s functions/ecm.usb0 configs/c.1/
for attempt in 1 2 3 4 5; do
    for udc in /sys/class/udc/*; do
        [ -e "$udc" ] || continue
        basename "$udc" > UDC
        exit 0
    done
    sleep 1
done
exit 1
