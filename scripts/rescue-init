#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /tmp /sys/kernel/config
mount -t devpts devpts /dev/pts
exec >/dev/kmsg 2>&1
echo 'qmodem RAM rescue: starting USB Ethernet'
mount -t debugfs debugfs /sys/kernel/debug
# Return to fastboot if userspace starts but USB bring-up cannot complete.
(
    sleep 20
    if [ ! -e /run/usb-ready ]; then
        echo 'qmodem: USB not ready; deferred devices follow'
        cat /sys/kernel/debug/devices_deferred
        ls -l /sys/class/udc
        sleep 10
        echo 'qmodem: rebooting after USB bring-up timeout'
        reboot -f
    fi
) &
hostname qmodem-rescue
ip link set lo up
mount -t configfs configfs /sys/kernel/config
cd /sys/kernel/config/usb_gadget
mkdir rescue
cd rescue
echo 0x1d6b > idVendor
echo 0x0104 > idProduct
mkdir -p strings/0x409
echo 430172fb > strings/0x409/serialnumber
echo qmodem > strings/0x409/manufacturer
echo 'UFI103S RAM rescue' > strings/0x409/product
mkdir -p configs/c.1/strings/0x409
echo 'USB Ethernet' > configs/c.1/strings/0x409/configuration
mkdir functions/ecm.usb0
echo '02:00:00:10:03:01' > functions/ecm.usb0/dev_addr
echo '02:00:00:10:03:02' > functions/ecm.usb0/host_addr
ln -s functions/ecm.usb0 configs/c.1/
while ! ls /sys/class/udc/* >/dev/null 2>&1; do sleep 1; done
echo "$(ls /sys/class/udc | head -n 1)" > UDC
ip addr add 192.168.77.1/24 dev usb0
ip -6 addr add fe80::1/64 dev usb0
ip link set usb0 up
cat >/run/udhcpd.conf <<'EOF'
start 192.168.77.2
end 192.168.77.10
max_leases 9
interface usb0
static_lease 02:00:00:10:03:02 192.168.77.2
option subnet 255.255.255.0
option lease 3600
lease_file /run/udhcpd.leases
pidfile /run/udhcpd.pid
EOF
touch /run/udhcpd.leases
udhcpd -f /run/udhcpd.conf &
mkdir -p /etc/dropbear
if dropbear -R -E -p 22 -P /run/dropbear.pid; then
    touch /run/usb-ready
else
    echo 'qmodem: SSH startup failed'
fi
echo 'SSH ready at 192.168.77.1; eMMC remains unmounted'
while true; do setsid cttyhack /bin/sh; sleep 1; done
